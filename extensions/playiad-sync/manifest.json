{
  "manifest_version": 3,
  "name": "Mandat OS — Sync Playiad Acquéreurs",
  "version": "1.0.1",
  "description": "Synchronise les leads acquéreurs depuis https://www.playiad.com/buyers/leads directement dans votre CRM Mandat OS.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.playiad.com/*",
    "https://*.playiad.fr/*",
    "https://*.iadfrance.fr/*",
    "https://*.myiad.fr/*",
    "http://localhost/*",
    "https://*.alexlopez-provence.fr/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Synchroniser Playiad avec Mandat OS"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.playiad.com/*",
        "https://*.playiad.fr/*",
        "https://*.iadfrance.fr/*",
        "https://*.myiad.fr/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
