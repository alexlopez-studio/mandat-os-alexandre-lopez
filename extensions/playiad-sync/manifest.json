{
  "manifest_version": 3,
  "name": "Mandat OS — Sync Playiad Acquéreurs",
  "version": "1.1.0",
  "description": "Synchronise automatiquement les leads acquéreurs depuis Playiad (https://www.playiad.com/buyers/leads) directement dans votre CRM Mandat OS.",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://*.playiad.com/*",
    "https://*.playiad.fr/*",
    "https://*.iadfrance.fr/*",
    "https://*.myiad.fr/*",
    "https://app.alexandrelopez.fr/*",
    "https://*.alexandrelopez.fr/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Synchroniser Playiad avec Mandat OS"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.playiad.com/*",
        "https://*.playiad.fr/*",
        "https://*.iadfrance.fr/*",
        "https://*.myiad.fr/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
